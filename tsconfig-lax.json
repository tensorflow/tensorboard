{
  "compilerOptions": {
    "downlevelIteration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    // See tsconfig.json for why this is needed.
    "ignoreDeprecations": "6.0",
    "importHelpers": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "lib": ["dom", "es2020"],
    "moduleResolution": "node",
    "noEmitOnError": false,
    "noErrorTruncation": false,
    "noResolve": true,
    "preserveConstEnums": false,
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": false,
    "strictNullChecks": true,
    "target": "es5",
    "useUnknownInCatchVariables": true,
    // See tsconfig.json for why these are disabled.
    "plugins": [
      {
        "name": "@bazel/tsetse",
        "disabledRules": [
          "ban-promise-as-condition",
          "must-use-promises",
          "ban-expect-truthy-promise"
        ]
      }
    ],
  }
}
