{
  "compilerOptions": {
    "downlevelIteration": true,
    "emitDecoratorMetadata": true,
    "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "inlineSourceMap": true,
    "lib": ["dom", "es2021", "dom.iterable"],
    "moduleResolution": "bundler",
    "module": "es2022",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "strict": true,
    // Don't scan the node_modules/@types folder for ambient types.
    // This would force us to have all the types in the dependencies of
    // each library.
    // Instead we'll be explicit about declaring ambient type dependencies
    // using the ///<reference types=""/> syntax.
    "types": [],
    "plugins": [
      {
        "name": "@bazel/tsetse",
        // disabled: concatjs pins tsutils to 3.21.0, which predates TS 5.9 and
        // is incompatible with these two rules. ban-promise-as-condition
        // crashes the compiler, must-use-promises misfires on the one
        // awaited call in alert_display_snackbar_container.ts.
        "disabledRules": ["ban-promise-as-condition", "must-use-promises"]
      }
    ]
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictNullInputTypes": true
  }
}
